AUTH_HOST=127.0.0.1
AUTH_PORT=8600
AUTH_DB=./db/auth.db

# Set to the parent domain covering every personal site (e.g. ".example.com")
# so the login cookie is shared across subdomains. Leave blank for local dev.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_TOKEN_TTL_HOURS=720
AUTH_RESET_TOKEN_TTL_MINUTES=30

# Bootstrap credential — consumed once, on first launch against an empty db.
AUTH_SEED_USERNAME=daniel
AUTH_SEED_PASSWORD=change-me-before-first-run

# Password-reset delivery. Leave SMTP_HOST blank in dev — the reset link is
# logged instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AUTH_RESET_EMAIL=daniel.stewart77@gmail.com
AUTH_RESET_LINK_BASE=http://127.0.0.1:8600
